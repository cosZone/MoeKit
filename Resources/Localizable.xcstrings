    "Your home Trash is empty": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "个人废纸篓为空"
          }
        }
      }
    },
    "Official analyzer location": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "官方分析器位置"
          }
        }
      }
