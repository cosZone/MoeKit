{
  "sourceLanguage": "en",
  "strings": {
    "See what is taking up space in one folder. First check Mole, then choose a folder and review the analysis.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See what is taking up space in one folder. First check Mole, then choose a folder and review the analysis."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看一个文件夹中的空间占用。先检查 Mole，再选择文件夹并复查分析范围。"
          }
        }
      }
    },
    "Step-by-step installation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Step-by-step installation"
          }
        },
        "zh-Hans": {
