      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "废纸篓"
          }
        }
      }
    },
    "Trash contents or their containing folders changed. Scan again and review a new confirmation.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "废纸篓内容或所在文件夹已发生变化。请重新扫描并复查新的确认。"
          }
        }
      }
    },
    "Trash location": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "废纸篓位置"
          }
        }
      }
    },
    "Trash management": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "废纸篓管理"
          }
        }
      }
    },
    "Trash operation cancelled. Already completed deletions cannot be undone; review every item’s actual outcome.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "废纸篓操作已取消。已完成的删除无法撤销；请复查每项的真实结果。"
          }
        }
      }
    },
    "Trash operation records": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "废纸篓操作记录"
          }
        }
      }
    },
    "Trash operation records could not be verified. Any retained data is preserved; nothing is retried automatically.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法验证废纸篓操作记录。保留数据将继续保留，不会自动重试。"
          }
        }
      }
    },
    "Trash operations are unavailable in Demo. Actual results from this session remain visible.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "示例模式下不可操作废纸篓。本次会话的真实操作结果仍会保留显示。"
          }
        }
      }
    },
    "Type EMPTY to confirm this complete snapshot": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入 EMPTY 以确认完整快照"
          }
        }
      }
    },
    "Waiting for the actual Trash outcome…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在等待废纸篓操作的真实结果…"
          }
        }
      }
    },
    "Your home Trash could not be read. Check macOS privacy permissions or inspect it in Finder, then scan again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取个人废纸篓。请检查 macOS 隐私权限，或先在 Finder 中检查，再重新扫描。"
          }
        }
      }
