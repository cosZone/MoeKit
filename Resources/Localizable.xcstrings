    "This Mole command is not connected. Only separately confirmed analysis is available.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Mole 命令尚未接入。目前仅提供单独确认后的分析功能。"
          }
        }
      }
    },
    "Mole returned an invalid or inconsistent report. No new report was accepted.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mole 返回的报告无效或存在矛盾。未接收新的报告。"
          }
        }
      }
    },
    "Analyzer limits: 120 seconds elapsed, 60 CPU seconds per process, 16 MB report and 64 KB diagnostics. Reports may be partial; sizes are not reclaimable space.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分析器限制：总用时 120 秒、每个进程 CPU 时间 60 秒、报告 16 MB、诊断 64 KB。报告可能不完整；显示大小不等于可回收空间。"
          }
        }
      }
    },
    "Verify analyzer before use": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用前需校验分析器"
          }
        }
      }
    },
    "Space supports report import and separately confirmed analysis with a verified official analyzer. Cleanup, uninstall, maintenance and live status remain unavailable.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "空间页面支持导入报告，以及使用已验证官方分析器的逐次确认分析。清理、卸载、维护和实时状态仍不可用。"
          }
        }
      }
    },
    "Official Mole V1.57.0 release": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mole V1.57.0 官方发布"
          }
        }
      }
    },
    "Space can import a JSON report without running Mole. Live analysis requires a separately verified official analyzer and confirmation. No cleanup command is connected.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "空间页面无需运行 Mole 即可导入 JSON 报告。实际分析需要单独校验官方分析器并确认。未接入任何清理命令。"
          }
        }
      }
    },
    "Choose one regular .dmg directly inside your local Downloads folder. Folders, .pkg files, links, cloud storage and external volumes are unsupported.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择本机“下载”文件夹直接包含的一个普通 .dmg 文件。不支持文件夹、.pkg 文件、链接、云存储或外置宗卷。"
          }
        }
      }
    },
    "The selected file or a containing folder changed. Review a new plan; no replacement is authorized.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选文件或其所在文件夹已发生变化。请重新查看操作方案；此确认不授权操作替换后的条目。"
          }
        }
      }
    },
    "Project, worktree and Git metadata locations are protected. A readable project catalog is required.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "项目、工作树及 Git 元数据位置受到保护。操作需要可读取的项目目录记录。"
          }
        }
      }
    },
    "This confirmation expired or was already used. Review a new plan.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此确认已过期或已使用。请重新查看操作方案。"
          }
        }
      }
    },
    "Another MoeKit file operation is active. Nothing was replaced.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一项 MoeKit 文件操作正在进行。未替换任何内容。"
          }
        }
      }
    },
    "Private recovery storage could not be validated. Existing files and permissions were left unchanged.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法验证私有恢复存储。现有文件及权限均未更改。"
          }
        }
      }
    },
    "A durable recovery record could not be saved. Any captured file is retained; review recovery before trying again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法持久保存恢复记录。已暂存的文件会被保留；再次尝试前请查看恢复记录。"
          }
        }
      }
    },
    "The destination already exists. MoeKit will not replace it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目标位置已存在条目。MoeKit 不会将其替换。"
          }
        }
      }
    },
    "This filesystem did not support the required same-device, no-overwrite move. There is no copy or deletion fallback.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件系统不支持所需的同设备、不覆盖移动。不会改用复制或删除操作。"
          }
        }
      }
    },
    "The operation was cancelled. Review the receipt for the file's actual location.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作已取消。请查看操作凭据，确认文件的实际位置。"
          }
        }
      }
    },
    "The file-use observation request is invalid.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件使用情况观察请求无效。"
          }
        }
      }
    },
    "The current-user process list is incomplete.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前用户的进程列表不完整。"
          }
        }
      }
    },
    "An open-file descriptor could not be validated.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法验证一个打开的文件描述符。"
          }
        }
      }
    },
    "A current-user process has this file open.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前用户的某个进程已打开此文件。"
          }
        }
      }
    },
    "The retained observation handle changed.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留用于观察的句柄已发生变化。"
          }
        }
      }
    },
    "A current-user process retains a fileport for this file.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前用户的某个进程持有此文件的 fileport 文件端口。"
          }
        }
      }
    },
    "Open-file handles changed during the observation. Check again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "观察期间，打开的文件句柄发生了变化。请重新检查。"
          }
        }
      }
    },
    "An open-file descriptor changed its file identity. Check again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
