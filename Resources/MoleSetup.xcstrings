    "Verify official Homebrew build": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "验证官方 Homebrew 构建"
          }
        }
      }
    },
    "Verifying the official Homebrew build…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在验证官方 Homebrew 构建…"
          }
        }
      }
    },
    "Version from installation metadata; file verification is separate.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "版本来自安装信息，文件验证需单独进行。"
          }
        }
      }
    },
    "Wait for “Mole analyzer ready”, then choose Recheck. If an error appears, stop and read it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待出现“Mole analyzer ready”，再点击“重新检查”。如有报错，请先停下来阅读提示。"
          }
        }
      }
    },
    "Your installed analyzer is verified. Choose a folder below.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已安装分析器已通过验证，请在下方选择文件夹。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
