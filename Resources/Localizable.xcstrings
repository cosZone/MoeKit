            "state": "translated",
            "value": "上次本地合并已完成"
          }
        }
      }
    },
    "Previous target branch": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上次的目标分支"
          }
        }
      }
    },
    "Project tests have not been run by MoeKit": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MoeKit 尚未运行项目测试"
          }
        }
      }
    },
    "Recovery: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复目录：%@"
          }
        }
      }
    },
    "Resolve these blockers before integrating": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合并前请先处理以下阻碍"
          }
        }
      }
    },
    "Review actual Git state, integrate committed work into a local branch, then separately review retiring the worktree. An AI completion message does not prove that files are saved, commits are merged, or tests have passed.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先复查实际 Git 状态，将已提交的工作合入本地分支，再单独复查工作树退役。AI 的完成消息不能证明文件已保存、提交已合并或测试已通过。"
          }
        }
      }
    },
    "Review retirement…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复查退役…"
          }
        }
      }
    },
    "Source branch": {
