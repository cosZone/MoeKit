    "Choose Downloads or another folder you want to inspect. Nothing runs until you review the plan and confirm.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose Downloads or another folder you want to inspect. Nothing runs until you review the plan and confirm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择“下载”或其他想检查的文件夹。只有复查方案并确认后，才会开始分析。"
          }
        }
      }
    },
    "Choose folder…": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose folder…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择文件夹…"
          }
        }
      }
    },
    "Change folder…": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change folder…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更换文件夹…"
          }
        }
      }
    },
    "Set up a compatible analyzer above to enable analysis.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set up a compatible analyzer above to enable analysis."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先按上方指引准备兼容的分析器，才能进行分析。"
          }
        }
      }
    },
    "Choose a folder to enable Review analysis.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a folder to enable Review analysis."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择文件夹后，即可复查分析方案。"
          }
        }
      }
    },
    "Advanced: analyzer file and check details": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Advanced: analyzer file and check details"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高级：分析器文件与检查详情"
          }
        }
      }
    },
    "Use this if you installed the official analyzer somewhere else. Choosing a file does not verify it; Review analysis checks it before offering a confirmation.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use this if you installed the official analyzer somewhere else. Choosing a file does not verify it; Review analysis checks it before offering a confirmation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果官方分析器安装在其他位置，可以在此选择。选择文件不代表验证通过；点击“复查分析…”后会先验证文件，再显示确认方案。"
          }
        }
      }
    },
    "Choose analyzer file…": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose analyzer file…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择分析器文件…"
          }
        }
      }
    },
    "Checked locations": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checked locations"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已检查的位置"
          }
        }
      }
    },
    "Only fixed installation locations are checked. No folder scan, shell, version command or analyzer process is started.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only fixed installation locations are checked. No folder scan, shell, version command or analyzer process is started."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只检查固定的安装位置，不扫描文件夹，不启动 Shell、版本命令或分析器进程。"
          }
        }
      }
    },
    "Setup is unavailable in Demo": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Setup is unavailable in Demo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "示例模式下不能准备分析器"
          }
        }
      }
    },
    "Checking for Mole…": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking for Mole…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在检查 Mole…"
          }
        }
      }
    },
    "Selected manually · unverified": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selected manually · unverified"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已手动选择 · 未验证"
          }
        }
      }
    },
    "Analyzer verified for this review": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyzer verified for this review"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分析器已通过本次复查验证"
          }
        }
      }
    },
    "Installation not checked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installation not checked"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未检查安装状态"
          }
        }
      }
    },
    "Leave Demo to check your installation and analyze a real folder. No installation is inspected in Demo.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave Demo to check your installation and analyze a real folder. No installation is inspected in Demo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出示例模式后，才能检查安装状态并分析真实文件夹。示例模式不会检查本机安装。"
          }
        }
      }
    },
    "Checking a small set of installation locations and the official analyzer's exact file contents. Mole is not being run.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking a small set of installation locations and the official analyzer's exact file contents. Mole is not being run."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在检查少量固定安装位置，并核对官方分析器的完整文件内容。不会运行 Mole。"
          }
        }
      }
    },
    "A file was selected manually. Choose a folder, then use Review analysis to verify that file.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A file was selected manually. Choose a folder, then use Review analysis to verify that file."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已手动选择文件。请选择文件夹，再点击“复查分析…”验证该文件。"
          }
        }
      }
    },
    "Read the confirmation below. The analyzer is checked again when you start the analysis.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read the confirmation below. The analyzer is checked again when you start the analysis."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请阅读下方确认方案。开始分析时还会再次验证分析器。"
          }
        }
      }
    },
    "Choose Recheck to look for a supported analyzer. This check does not run Mole or install anything.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose Recheck to look for a supported analyzer. This check does not run Mole or install anything."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击“重新检查”查找受支持的分析器。检查不会运行 Mole，也不会安装任何内容。"
          }
        }
      }
    },
    "The official V1.57.0 analyzer was verified for this app. Choose a folder below; it will be checked again before each analysis.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The official V1.57.0 analyzer was verified for this app. Choose a folder below; it will be checked again before each analysis."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已验证与本应用匹配的官方 V1.57.0 分析器。请在下方选择文件夹；每次分析前都会再次验证分析器。"
          }
        }
      }
    },
    "No analyzer was found in the checked locations. Follow the steps below, or use Advanced if yours is installed elsewhere.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No analyzer was found in the checked locations. Follow the steps below, or use Advanced if yours is installed elsewhere."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在已检查的位置未找到分析器。请按下方步骤操作；如果安装在其他位置，可使用“高级”选项。"
          }
        }
      }
    },
    "An installed file does not match the supported official V1.57.0 analyzer. Homebrew builds, custom builds and other versions are not supported; use the guide below.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An installed file does not match the supported official V1.57.0 analyzer. Homebrew builds, custom builds and other versions are not supported; use the guide below."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发现的文件与受支持的官方 V1.57.0 分析器不匹配。暂不支持 Homebrew、自编译或其他版本，请参阅下方指引。"
          }
        }
      }
    },
    "MoeKit could not verify a compatible analyzer. It may be unreadable, a command wrapper or blocked by macOS. Review Advanced for the reason before continuing.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MoeKit could not verify a compatible analyzer. It may be unreadable, a command wrapper or blocked by macOS. Review Advanced for the reason before continuing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MoeKit 无法验证兼容的分析器。文件可能无法读取、只是命令包装脚本，或被 macOS 阻止。请先在“高级”中查看原因。"
          }
        }
      }
    },
