          }
        }
      }
    },
    "The selected folder or analyzer changed. Choose them again and review a new analysis plan.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选文件夹或分析器已变化。请重新选择并复查新的分析计划。"
          }
        }
      }
    },
    "This file does not match the supported official Mole V1.57.0 analyzer for this Mac. No tool was run.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件与本机受支持的 Mole V1.57.0 官方分析器不匹配。未运行任何工具。"
          }
        }
      }
    },
    "Verifying analyzer…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在校验分析器…"
          }
        }
      }
    },
    "macOS quarantine is present on this analyzer. MoeKit will not remove it or bypass Gatekeeper.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此分析器带有 macOS 隔离标记。MoeKit 不会移除标记或绕过 Gatekeeper。"
          }
        }
      }
